# Token do bot do Telegram, obtido com o @BotFather (comando /newbot).
# Copie este arquivo para ".env" e cole o token real ali - NUNCA commitar o .env.
TELEGRAM_BOT_TOKEN=

# API Key do Google Gemini (aistudio.google.com), usada pelo agente inteligente
# do Telegram para conversação livre, consultas financeiras, lançamentos e ajustes estruturais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# API key da Anthropic (opcional / legado).
ANTHROPIC_API_KEY=
