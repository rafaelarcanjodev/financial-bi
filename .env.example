# Token do bot do Telegram, obtido com o @BotFather (comando /newbot).
# Copie este arquivo para ".env" e cole o token real ali - NUNCA commitar o .env.
TELEGRAM_BOT_TOKEN=

# API Key do Google Gemini (aistudio.google.com), usada pelo agente inteligente
# do Telegram para conversação livre, consultas financeiras, lançamentos e ajustes estruturais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Caminho opcional do arquivo master.json no Google Drive para auto-backup
DRIVE_MASTER_PATH=G:\Meu Drive\FINANCEIRO_DATABASE\master.json

# Configuração do proxy reverso Caddy (HTTPS automático + Basic Auth em produção)
CADDY_DOMAIN=localhost
BASIC_AUTH_USER=rafael
BASIC_AUTH_HASH=
